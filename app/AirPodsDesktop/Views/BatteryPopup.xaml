<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="AirPodsDesktop.Views.BatteryPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="准备好，继续聆听" CloseButtonText="好的" DefaultButton="Close">
    <StackPanel Spacing="20" MinWidth="280">
        <TextBlock Text="AirPods 当前电量" Style="{StaticResource SecondaryTextStyle}" />
        <Border Style="{StaticResource BatteryTileStyle}">
            <StackPanel Spacing="10">
                <TextBlock x:Name="PopupLeft" Text="左耳 —" FontSize="18" FontWeight="SemiBold" />
                <ProgressBar x:Name="PopupLeftBar" Height="5" Minimum="0" Maximum="100" Foreground="{ThemeResource BrandBrush}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource BatteryTileStyle}">
            <StackPanel Spacing="10">
                <TextBlock x:Name="PopupRight" Text="右耳 —" FontSize="18" FontWeight="SemiBold" />
                <ProgressBar x:Name="PopupRightBar" Height="5" Minimum="0" Maximum="100" Foreground="{ThemeResource BrandBrush}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource BatteryTileStyle}">
            <StackPanel Spacing="10">
                <TextBlock x:Name="PopupCase" Text="充电盒 —" FontSize="18" FontWeight="SemiBold" />
                <ProgressBar x:Name="PopupCaseBar" Height="5" Minimum="0" Maximum="100" Foreground="{ThemeResource BrandBrush}" />
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>
