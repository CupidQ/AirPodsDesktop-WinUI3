<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AirPodsDesktop.Views.ControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="28,24,28,32" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="20" MaxWidth="780">
            <TextBlock Text="耳机控制" Style="{StaticResource PageHeadingStyle}" />
            <TextBlock Text="在 Windows 上修改耳机的听音模式与设置。请先配对并连接 AirPods。" Style="{StaticResource SecondaryTextStyle}" />
            <Border Style="{StaticResource SurfaceStyle}">
                <StackPanel Spacing="12">
                    <ComboBox x:Name="DeviceSelector" Header="选择要控制的耳机" HorizontalAlignment="Stretch" />
                    <Grid ColumnSpacing="8" RowSpacing="8" SizeChanged="ControlActions_SizeChanged">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Button x:Name="RefreshButton" Content="刷新设备" Click="Refresh_Click" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Stretch" />
                        <Button x:Name="ConnectButton" Grid.Column="1" Content="连接控制通道" Click="Connect_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" />
                        <Button x:Name="DisconnectButton" Grid.Column="2" Content="断开控制通道" IsEnabled="False" Click="Disconnect_Click" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Stretch" />
                    </Grid>
                    <ProgressRing x:Name="BusyRing" Width="24" Height="24" IsActive="False" HorizontalAlignment="Left" />
                    <TextBlock x:Name="ConnectionText" Text="正在检测控制设备…" TextWrapping="Wrap" />
                    <TextBlock x:Name="DriverText" Text="此功能需要另行安装 MagicAAP 驱动；安装包提供控制客户端。"
                               TextWrapping="Wrap" Opacity="0.7" />
                    <HyperlinkButton Content="查看 MagicAAP 驱动说明" Click="DriverHelp_Click" Padding="0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="ModeText" Text="当前听音模式：等待耳机回传" TextWrapping="Wrap" />
                    <ComboBox x:Name="ModeSelector" Header="切换听音模式" IsEnabled="False" SelectionChanged="Mode_Changed">
                        <ComboBoxItem Content="降噪" Tag="2" />
                        <ComboBoxItem Content="通透" Tag="3" />
                        <ComboBoxItem x:Name="AdaptiveOption" Content="自适应" Tag="4" IsEnabled="False" />
                    </ComboBox>
                    <CheckBox x:Name="ConversationCheck" Content="对话感知" IsChecked="{x:Null}" IsEnabled="False" Click="Conversation_Click" />
                    <CheckBox x:Name="OneEarCheck" Content="只戴一只耳机时允许降噪" IsChecked="{x:Null}" IsEnabled="False" Click="OneEar_Click" />
                    <CheckBox x:Name="DuckCheck" Content="对话时降低 Windows 输出音量" IsEnabled="False" Click="Duck_Click" />
                    <TextBlock Text="音量联动会把当前默认输出的所有应用音量降至原来的 30%，对话结束后恢复。中途手动调过音量时保留新值。"
                               TextWrapping="Wrap" Opacity="0.7" />
                    <TextBlock x:Name="SpeakingText" Text="对话状态：等待耳机回传" Opacity="0.7" />
                    <TextBlock x:Name="ActionText" Text="各项设置在收到耳机回传后开放；不支持的选项保持不可用。" TextWrapping="Wrap" Opacity="0.7" />
                    <TextBlock x:Name="VolumeText" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
