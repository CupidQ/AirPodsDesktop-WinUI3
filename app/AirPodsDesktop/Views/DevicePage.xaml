<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="AirPodsDesktop.Views.DevicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="28,20,28,28" HorizontalContentAlignment="Stretch">
        <StackPanel MaxWidth="780" Spacing="16">
            <StackPanel Spacing="6">
                <TextBlock Text="我的设备" Style="{StaticResource PageHeadingStyle}" />
                <TextBlock Text="电量、佩戴状态，一眼就好。" Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <Border Background="{ThemeResource HeroBrush}" CornerRadius="24" Padding="24,20">
                <Grid x:Name="DeviceHero" ColumnSpacing="16" SizeChanged="DeviceHero_SizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="12" VerticalAlignment="Center">
                        <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="6" Height="6" Fill="{ThemeResource BrandBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusBadgeText" Text="等待设备" FontSize="12" Foreground="{ThemeResource BrandBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ModelText" Text="你的 AirPods" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="DeviceHintText" Text="打开充电盒，让耳机靠近电脑。" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Name="RssiText" Text="尚未收到设备信号" Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                    </StackPanel>
                    <!-- Decorative artwork; all device status comes from the core. -->
                    <Viewbox x:Name="EarbudsArtwork" Grid.Column="1" Width="132" Height="132" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                        <Canvas Width="160" Height="160">
                            <Ellipse Canvas.Left="8" Canvas.Top="14" Width="144" Height="132" Fill="{ThemeResource SurfaceBrush}" Opacity="0.35" />
                            <Ellipse Canvas.Left="25" Canvas.Top="128" Width="112" Height="12" Fill="#172A24" Opacity="0.08" />
                            <Path Data="M 51,30 C 29,30 23,39 23,51 C 23,65 35,71 48,68 L 48,113 C 48,121 53,124 59,121 C 63,119 64,115 64,110 L 64,53 C 64,39 62,30 51,30 Z" Fill="#FFFFFF" Stroke="#CAD5D1" StrokeThickness="1.5" />
                            <Ellipse Canvas.Left="29" Canvas.Top="41" Width="12" Height="17" Fill="#34423E" />
                            <Rectangle Canvas.Left="52" Canvas.Top="109" Width="8" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#A4B3AD" />
                            <Path Data="M 109,40 C 131,40 137,49 137,61 C 137,75 125,81 112,78 L 112,123 C 112,131 107,134 101,131 C 97,129 96,125 96,120 L 96,63 C 96,49 98,40 109,40 Z" Fill="#FFFFFF" Stroke="#CAD5D1" StrokeThickness="1.5" />
                            <Ellipse Canvas.Left="119" Canvas.Top="51" Width="12" Height="17" Fill="#34423E" />
                            <Rectangle Canvas.Left="100" Canvas.Top="119" Width="8" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#A4B3AD" />
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Border>
            <Grid x:Name="BatteryTiles" ColumnSpacing="12" RowSpacing="12" SizeChanged="BatteryTiles_SizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border x:Name="LeftTile" Grid.Column="0" Style="{StaticResource BatteryTileStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="左耳" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Name="LeftBatteryText" Text="—" FontSize="28" FontWeight="SemiBold" />
                        <ProgressBar x:Name="LeftBatteryBar" Minimum="0" Maximum="100" Height="5" Foreground="{ThemeResource BrandBrush}" />
                        <TextBlock x:Name="LeftInEarText" Text="等待电量" Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border x:Name="RightTile" Grid.Column="1" Style="{StaticResource BatteryTileStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="右耳" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Name="RightBatteryText" Text="—" FontSize="28" FontWeight="SemiBold" />
                        <ProgressBar x:Name="RightBatteryBar" Minimum="0" Maximum="100" Height="5" Foreground="{ThemeResource BrandBrush}" />
                        <TextBlock x:Name="RightInEarText" Text="等待电量" Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border x:Name="CaseTile" Grid.Column="2" Style="{StaticResource BatteryTileStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="充电盒" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Name="CaseBatteryText" Text="—" FontSize="28" FontWeight="SemiBold" />
                        <ProgressBar x:Name="CaseBatteryBar" Minimum="0" Maximum="100" Height="5" Foreground="{ThemeResource BrandBrush}" />
                        <TextBlock x:Name="LidText" Text="等待电量" Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Padding="4,4,4,0">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="StatusText" Text="打开充电盒后，电量会自动更新。" Style="{StaticResource SecondaryTextStyle}" />
                    <Grid x:Name="ScanActions" RowSpacing="8" ColumnSpacing="8" SizeChanged="ScanActions_SizeChanged">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button x:Name="StartScanButton" Content="开始扫描" Click="StartScan_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" />
                        <Button x:Name="StopScanButton" Grid.Column="1" Content="暂停扫描" Click="StopScan_Click" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
            </Border>
            <Expander Header="高级 · 广播地址过滤" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBlock Text="附近有多副耳机时，可暂时只读取当前设备。广播地址会随机变化；锁定地址不代表蓝牙配对。" Style="{StaticResource SecondaryTextStyle}" />
                    <Button x:Name="BindDeviceButton" Content="锁定当前广播地址" Click="BindDevice_Click" Style="{StaticResource QuietButtonStyle}" />
                    <Button x:Name="UnbindDeviceButton" Content="解除锁定" Click="UnbindDevice_Click" Style="{StaticResource QuietButtonStyle}" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
