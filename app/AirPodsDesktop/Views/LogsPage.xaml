<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AirPodsDesktop.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="日志" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button Content="刷新" Click="Refresh_Click" />
            <Button Content="打开日志目录" Click="OpenFolder_Click" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <TextBlock x:Name="LogText" FontFamily="Consolas" TextWrapping="Wrap" />
        </ScrollViewer>
    </Grid>
</Page>
